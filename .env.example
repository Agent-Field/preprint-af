# --- Provider key ---
OPENROUTER_API_KEY=sk-or-v1-...

# --- Model selection (LiteLLM-style strings; provider prefix required) ---
AI_MODEL=openrouter/deepseek/deepseek-v4-pro
OPENCODE_MODEL=openrouter/deepseek/deepseek-v4-pro

# --- Harness knobs ---
# Wall-clock cap per OpenCode call (the only cap OpenCode honors)
AGENTFIELD_HARNESS_TIMEOUT_SECONDS=1800
# Concurrent OpenCode subprocesses (section/figure fan-out throttle)
OPENCODE_MAX_CONCURRENT=10
# Kept for provider portability (ignored by opencode provider)
HARNESS_MAX_TURNS=40
HARNESS_MAX_BUDGET_USD=5.00
HARNESS_PERMISSION_MODE=auto

# --- Node ---
AGENT_NODE_ID=preprint-af
AGENT_NODE_PORT=8001
AGENTFIELD_HTTP_PORT=8080

# --- Docker input/output mounts ---
# docker-compose.yml persists generated runs to ./.tmp and mounts this host paper
# root read-only so absolute folder_path values under it work inside the container.
HOST_PAPERS_ROOT=/Users/santoshkumar/Documents/agentfield/papers
